{
  "name": "siatube-backend-v2",
  "version": "1.0.0",
  "description": "Node.js library for fetching YouTube video, search, channel, comment, playlist, and suggestion data.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./video": "./video/index.js",
    "./video/app": "./video/app.js",
    "./search": "./search/index.js",
    "./search/app": "./search/app.js",
    "./channel": "./channel/index.js",
    "./channel/app": "./channel/app.js",
    "./comment": "./comment/index.js",
    "./comment/app": "./comment/app.js",
    "./playlist": "./playlist/index.js",
    "./playlist/app": "./playlist/app.js",
    "./suggest": "./suggest/index.js",
    "./suggest/app": "./suggest/app.js"
  },
  "bin": {
    "siatube": "./bin/siatube.js"
  },
  "files": [
    "bin/siatube.js",
    "client.js",
    "index.js",
    "USAGE.md",
    "scripts/check-request-config.mjs",
    "channel/app.js",
    "channel/index.js",
    "comment/app.js",
    "comment/index.js",
    "playlist/app.js",
    "playlist/index.js",
    "search/app.js",
    "search/index.js",
    "shared/youtube-request-config.js",
    "suggest/app.js",
    "suggest/index.js",
    "video/app.js",
    "video/index.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --check ./index.js && node --check ./client.js && node --check ./video/index.js && node --check ./search/index.js && node --check ./channel/index.js && node --check ./comment/index.js && node --check ./playlist/index.js && node --check ./suggest/index.js",
    "pack:check": "npm pack --dry-run --cache /tmp/siatube-npm-cache",
    "config:check": "node ./scripts/check-request-config.mjs"
  },
  "keywords": [
    "youtube",
    "api",
    "scraper",
    "search",
    "playlist",
    "comments"
  ],
  "author": "siatube-sia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siatube-sia/siatube-backend-v2.git"
  },
  "homepage": "https://github.com/siatube-sia/siatube-backend-v2#readme",
  "bugs": {
    "url": "https://github.com/siatube-sia/siatube-backend-v2/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "youtubei.js": "^15.1.0"
  }
}
