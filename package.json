{
  "name": "siatube-backend-v2",
  "version": "1.0.0",
  "description": "Node.js library for fetching YouTube video, search, channel, comment, playlist, and suggestion data.",
  "type": "module",
  "main": "./index.js",
  "sideEffects": false,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./video": "./video/index.js",
    "./search": "./search/index.js",
    "./channel": "./channel/index.js",
    "./comment": "./comment/index.js",
    "./playlist": "./playlist/index.js",
    "./suggest": "./suggest/index.js"
  },
  "files": [
    "client.js",
    "index.js",
    "USAGE.md",
    "scripts/check-request-config.mjs",
    "channel/index.js",
    "comment/index.js",
    "playlist/index.js",
    "search/index.js",
    "shared/youtube-request-config.js",
    "suggest/index.js",
    "video/index.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --check ./index.js && node --check ./client.js && node --check ./video/index.js && node --check ./search/index.js && node --check ./channel/index.js && node --check ./comment/index.js && node --check ./playlist/index.js && node --check ./suggest/index.js",
    "pack:check": "npm pack --dry-run --cache /tmp/siatube-npm-cache",
    "config:check": "node ./scripts/check-request-config.mjs"
  },
  "keywords": [
    "youtube",
    "api",
    "scraper",
    "search",
    "playlist",
    "comments"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "youtubei.js": "^15.1.0"
  }
}
